# Cabeceras de Cloudflare Pages (fase 4, D24 y D26). `scripts/prepare-pages.mjs` pone en la CSP, en
# lugar del marcador de `script-src`, los hashes de los scripts en línea que genera Angular.
# Un patrón por línea, sin sangría, y sus cabeceras debajo, con sangría. Si dos reglas que coinciden
# dan la misma cabecera, Pages une sus valores con una coma: cada cabecera sale de una sola regla.

# Todo el sitio. La CSP solo admite lo propio: sin terceros (D24), sin `eval` y sin manejadores en
# línea. Los estilos en línea son los de los componentes de Angular y el CSS crítico de la página.
# La geolocalización, solo para «usar mi ubicación» de El cielo desde España (fase 8). Se intentan
# quitar las cabeceras de Network Error Logging de Cloudflare (harían que el navegador enviara informes
# de errores a un dominio de Cloudflare, D24), pero las añade la red de Cloudflare después de Pages:
# en el dominio propio las quita una regla de la zona de ivanchesa.com (fase 11) y solo salen en las
# direcciones de pages.dev (la de producción y las vistas previas), que no pasan por ella.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' {{INLINE_SCRIPTS}}; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  ! Report-To
  ! NEL

# La dirección de Pages y las vistas previas, fuera de los buscadores: desde la fase 11, el sitio se
# indexa solo en el dominio propio, que no lleva esta cabecera (las vistas previas ya llevan `noindex`
# de Pages; aquí, también la dirección de producción en pages.dev). No quitarlas.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Con hash en el nombre (JS, CSS y las texturas): un año, inmutables. Las fuentes, desde la fase 9, en
# /fonts/ con su nombre fijo (abajo).
/main-*
  Cache-Control: public, max-age=31536000, immutable

/chunk-*
  Cache-Control: public, max-age=31536000, immutable

/styles-*
  Cache-Control: public, max-age=31536000, immutable

/textures/*
  Cache-Control: public, max-age=31536000, immutable

# Sin hash (los pósters, las miniaturas, las imágenes de las fichas, el catálogo de estrellas y las
# fuentes, con su nombre fijo para precargarlas): un día, para que una versión nueva llegue sin esperar.
# El HTML lleva el valor de Pages (se revalida siempre).
/img/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=86400

/data/*
  Cache-Control: public, max-age=86400
